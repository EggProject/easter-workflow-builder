diff --git a/apps/web/src/app-mount/main.tsx b/apps/web/src/app-mount/main.tsx
index d36c1ae..6afdd3a 100644
--- a/apps/web/src/app-mount/main.tsx
+++ b/apps/web/src/app-mount/main.tsx
@@ -1,3 +1,12 @@
+import {
+  createCelExpressionEvaluator,
+  createMustacheTemplateRenderer,
+} from '@easter-workflow-builder/workflow-language';
 import { mountApp } from './mount-app.tsx';
 
+// T-010-5 eldobható mérés: a két csomag a böngésző bundle-be kerül.
+const probeTemplate = createMustacheTemplateRenderer().render('{{input.x}}', { input: { x: 'y' } });
+const probeExpression = createCelExpressionEvaluator().evaluate('input.x == "y"', { input: { x: 'y' } });
+document.documentElement.dataset['workflowLanguageProbe'] = `${probeTemplate.kind}:${probeExpression.kind}`;
+
 mountApp();
