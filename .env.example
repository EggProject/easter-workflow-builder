# A szerver env mintája (SPEC-012 4.3). Másolat: `cp .env.example .env`. A `.env` fájl
# kizárt a gitből, titok csak oda kerül. A `start:server` és a `dev:server` script
# (`node --env-file-if-exists=.env`) tölti; a már beállított környezeti változó nyer a fájl
# fölött. Minden érték az alapérték a kódban (apps/server/src/server-config/default-server-config.ts),
# a fájl nélkül is ez érvényes. Források: docs/research/2026-10-26-helyi-inditas-es-valodi-proba.md.

# A szerver portja (user termékdöntés 2026-09-05; research 10.2). A szerver a 127.0.0.1 címre köt.
EASTER_SERVER_PORT=3001

# Az SSE életben tartó jelzés gyakorisága ezredmásodpercben (WHATWG HTML 9.2.7 "every 15 seconds
# or so"; research 10.1).
EASTER_STREAM_KEEP_ALIVE_INTERVAL_MS=15000

# FÁJL ÚTVONAL ELŐTAG, nem könyvtár: a napló a `<érték>.1.log` fájlba kerül, tehát itt
# `.data/logs/server.1.log` (a név félrevezető, átnevezés nincs; research 2., M-142, M-146).
# A `.data/` kizárt a gitből.
EASTER_LOG_DIRECTORY=.data/logs/server

# Forgatás méret szerint: 10 MiB (a `pino-roll` `m` utótagja 1024 négyzet bájt). Szállított
# alapérték: kubelet 10Mi, pm2-logrotate 10M, Spring Boot 10MB (research 13.1, M-146).
EASTER_LOG_ROTATION_SIZE=10m

# Forgatás időköz szerint: 7 nap ezredmásodpercben, mert a `pino-roll` 4.0.0 a `weekly` nevet
# nem ismeri; a határ UTC csütörtök 00:00. A `logrotate` `weekly` értéke (research 13.1, M-146).
# A `daily` és az `hourly` név is megadható.
EASTER_LOG_ROTATION_FREQUENCY=604800000

# Megőrzött forgatott naplófájlok száma az aktív fájlon felül, a teljes könyvtárra (a
# `logrotate` `rotate 4`; research 13.1). A `pino-roll` `removeOtherLogFiles: true` módban fut.
EASTER_LOG_RETAINED_FILE_COUNT=4

# Opcionális: a böngészőben megnyitott web origin, CORS engedély az SSE útvonalra. Hiányában a
# szerver egyetlen CORS fejlécet sem küld. A `localhost` és a `127.0.0.1` eltérő origin; a Vite
# dev szerver címe `http://localhost:5173` (research 10.3, 14.6).
EASTER_STREAM_DEV_ORIGIN=http://localhost:5173

# Opcionális: az adatbázis fájl útvonala. Hiányában `.data/easter-workflow-builder.sqlite`.
# EASTER_DB_FILE=

# Opcionális: a naplószint. Hiányában a pino alapértéke (`info`).
# EASTER_LOG_LEVEL=

# A `minimax` provider kulcsa, két néven is megadható: `ANTHROPIC_AUTH_TOKEN` vagy
# `ANTHROPIC_API_KEY` (SPEC-013 4.1). Bármelyik név elég; ha mindkettő áll, az
# `ANTHROPIC_AUTH_TOKEN` nyer (SPEC-013 4.3). A lépés felé a kulcs mindig `ANTHROPIC_AUTH_TOKEN`
# néven megy ki. A sorok szándékosan kikommentelt és érték nélküliek: egy üres `NÉV=` sor üres
# sztringként jutna a folyamat környezetébe, nem hiányzó változóként, mindkét névnél; a kulcs
# feloldása az üres értéket hiányzónak veszi (SPEC-013 4.3). A kulcsot a
# saját `.env` fájlodba írd, ide soha. A régi `MINIMAX_API_KEY` név nem működik (SPEC-012 2.4,
# O-1). A `claude-subscription` provider nem kér env változót, a Claude Code `/login`
# bejelentkezését használja, és egyik kulcsnév sem jut el hozzá.
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_API_KEY=
