{
  "name": "easter-workflow-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*",
    "tools/*"
  ],
  "catalog": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unicorn": "73.0.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "overrides": {
    "type-fest": "4.41.0"
  },
  "scripts": {
    "build": "bash tooling/scripts/build.sh",
    "typecheck": "bash tooling/scripts/typecheck.sh",
    "lint": "bash tooling/scripts/lint.sh",
    "format": "bash tooling/scripts/format.sh --write",
    "format:check": "bash tooling/scripts/format.sh",
    "docs:check": "bash tooling/scripts/claude-md.sh",
    "test": "vitest run --coverage",
    "test:e2e": "turbo run test:e2e",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config": "workspace:*",
    "eslint-config-prettier": "catalog:",
    "happy-dom": "20.11.6",
    "jiti": "2.7.0",
    "prettier": "catalog:",
    "turbo": "2.10.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
