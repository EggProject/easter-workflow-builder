{
  "name": "easter-workflow-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": ["apps/*", "packages/*", "tooling/*", "tools/*"],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
