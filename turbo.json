{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "bun.lock",
    "tooling/tsconfig/**",
    "tooling/eslint-config/**",
    "turbo.json",
    "eslint.config.ts",
    ".prettierrc.json",
    ".prettierignore"
  ],
  "globalEnv": ["CI", "NODE_ENV"],
  "globalPassThroughEnv": [
    "ANTHROPIC_BASE_URL",
    "ANTHROPIC_AUTH_TOKEN",
    "MINIMAX_API_KEY",
    "MINIMAX_API_BASE_URL",
    "MINIMAX_TIMEOUT_MS",
    "FIRECRAWL_BASE_URL",
    "FIRECRAWL_TIMEOUT_MS",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",
    "CLAUDE_CODE_ENABLE_FINE_GRAINED_TOOL_STREAMING",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING",
    "MAX_THINKING_TOKENS"
  ],
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true,
      "persistent": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": true,
      "persistent": false
    },
    "lint": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": true,
      "persistent": false
    },
    "//#format:check": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "cache": true,
      "persistent": false
    },
    "//#test": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/*/src/**",
        "apps/*/src/**",
        "tools/wire-probe/src/**",
        "tooling/scripts/src/**",
        "vitest.config.ts"
      ],
      "outputs": ["coverage/**"],
      "cache": true,
      "persistent": false
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "**/e2e/**", "!**/e2e/.nyc_output/**", "**/playwright.config.ts"],
      "outputs": ["playwright-report/**", "test-results/**", "e2e/.nyc_output/**"],
      "cache": true,
      "persistent": false
    },
    "dev": {
      "dependsOn": [],
      "cache": false,
      "persistent": true
    }
  }
}
