# A web env mintája (SPEC-012 4.3). Másolat: `cp apps/web/.env.example apps/web/.env`. A Vite
# ezt a fájlt tölti (`bun run dev:web`); a már beállított környezeti változó nyer a fájl fölött.
# Csak a `VITE_` előtagú változó jut a kliensnek, titok ide soha nem kerül. Minden érték az
# alapérték a kódban (apps/web/src/frontend-config/default-frontend-config.ts), a fájl nélkül is
# ez érvényes. Források: docs/research/2026-10-26-helyi-inditas-es-valodi-proba.md.

# A REST hívások origin je: a Vite dev szerver saját címe, a `/api` proxyn át (Vite `server.host`
# `localhost`, `server.port` `5173`; research 10.3).
VITE_API_ORIGIN=http://localhost:5173

# Az SSE csatorna és a `/api` proxy célja: a szerver címe (127.0.0.1, a szerver bind címe, és a
# `3001` port; research 10.2, 10.4).
VITE_STREAM_ORIGIN=http://127.0.0.1:3001

# A lista végpontok `limit` paramétere. Slack alapérték és ajánlás, a GitHub, Stripe és GitLab
# közös maximuma (research 13.2). FIGYELEM: 100 fölött a lista levágódik, lapozás nincs.
VITE_LIST_LIMIT=100

# A stream visszajátszás lapmérete (nem plafon). A Slack `conversations.history`, az Ably history
# és a Loki `query_range` alapértéke (research 13.3).
VITE_STREAM_REPLAY_LIMIT=100
