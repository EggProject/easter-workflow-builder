{
  "name": "web",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint .",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "coverage:e2e:report": "nyc report --temp-dir e2e/.nyc_output --report-dir coverage-e2e --reporter=text --reporter=html --reporter=lcov"
  },
  "dependencies": {
    "core": "workspace:*",
    "protocol": "workspace:*",
    "ui": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "nyc": "18.0.0",
    "vite": "8.2.2",
    "vite-plugin-istanbul": "9.0.1",
    "vitest": "catalog:"
  }
}
